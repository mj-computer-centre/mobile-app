# Secrets for the edge functions. Copy this file to supabase/functions/.env (git-ignored), fill
# it in, check it with `pnpm images:verify`, then send it to each Supabase project:
#   pnpm dlx supabase secrets set --env-file supabase/functions/.env
# These never go in apps/mobile: anything the app can read, a student can read.
# How to get each value: docs/operations/supabase.md, section 4.

# Pictures (course covers and home banners) are kept on Cloudinary.
# cloudinary.com → Dashboard → API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# The app's own folder in the account. Covers go to <folder>/courses, banners to
# <folder>/banners, and nothing outside the folder is ever removed.
CLOUDINARY_FOLDER=mishra-computer-centre

# "Make one with AI" draws course pictures with Cloudflare Workers AI. Free: 10,000 neurons a
# day, and a picture costs about 173, so about 57 pictures a day; the app stops at 40.
# dash.cloudflare.com → Workers AI → Use REST API: the Account ID, and "Create a Workers AI API
# Token".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# The YouTube Data API key is set on its own (docs/operations/supabase.md, section 3):
#   pnpm dlx supabase secrets set YOUTUBE_API_KEY=<key>
