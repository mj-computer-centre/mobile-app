# Copy to .env.local and fill in. Values starting with EXPO_PUBLIC_ are built into the app and
# are visible to anyone who has it, so only public values go here (never the service-role key).

# Supabase → Project settings → API
EXPO_PUBLIC_SUPABASE_URL="https://rglizntmgvytufkxrecc.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_Og9RKBOVGMK_pAp6Ju-rVQ_YCQ-hYbW"

# Google Cloud → APIs & Services → Credentials → the "Web application" OAuth client
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="444929597413-ul48efet53rjni9q1sfgbi8v5mvb8riq.apps.googleusercontent.com"

# Google Cloud → Credentials → Create credentials → OAuth client ID → Android (one client per
# signing key; nothing from it goes into this file). Copy these two values from here:
#   Package name: in.mishracomputercentre.app
#   SHA-1 of the upload key (~/mcc-android-build/signing, used for the APKs built on the Mac):
#   A8:26:CD:EE:02:50:5B:6A:B7:4F:E5:A0:5C:5D:9A:32:F5:95:3D:DB
#   After the first Play upload, add one more Android client with the "App signing key" SHA-1
#   from Play Console → Test and release → App integrity → App signing.

# The self-hosted YouTube player page on the admin website (public/youtube-player.html).
# Leave empty to use the library's default page until the admin website is deployed.
EXPO_PUBLIC_PLAYER_PAGE_URL=

# iOS builds only: the reversed iOS client id from Google Cloud.
GOOGLE_IOS_URL_SCHEME=

# DEVELOPMENT ONLY. Skips Google sign-in and runs the app on demo data, acting as this role:
# visitor | student | admin | owner (empty = off). `visitor` shows the public website as someone
# who has not signed in sees it. Nothing is read from or saved to Supabase while it is on.
# Ignored in release bundles, and release builds fail while it is set.
EXPO_PUBLIC_DEV_AUTH_BYPASS=

# Not here: the Cloudinary keys (pictures) and the Cloudflare keys (AI pictures). The app would
# hand them to every student. They are secrets of the edge functions: see
# supabase/functions/.env.example and docs/operations/supabase.md, section 4.
